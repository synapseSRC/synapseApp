CREATE TABLE CachedMessage (
    id TEXT NOT NULL PRIMARY KEY,
    chat_id TEXT NOT NULL,
    sender_id TEXT NOT NULL,
    content TEXT NOT NULL,
    message_type TEXT NOT NULL DEFAULT 'text',
    media_url TEXT,
    delivery_status TEXT NOT NULL DEFAULT 'SENT',
    content_status TEXT NOT NULL DEFAULT 'ACTIVE',
    read_by TEXT,
    created_at TEXT NOT NULL,
    sent_at TEXT,
    delivered_at TEXT,
    read_at TEXT,
    edited_at TEXT,
    deleted_at TEXT,
    expires_at TEXT,
    reply_to_id TEXT,
    failure_reason TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    is_edited INTEGER NOT NULL DEFAULT 0,
    cached_at INTEGER NOT NULL,
    metadata TEXT,
    -- Sync metadata
    updated_at INTEGER NOT NULL DEFAULT 0,
    is_locally_deleted INTEGER NOT NULL DEFAULT 0,
    last_synced_at INTEGER DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 1
);

upsertMessage:
INSERT OR REPLACE INTO CachedMessage VALUES ?;

selectByChatId:
SELECT * FROM CachedMessage
WHERE chat_id = :chatId
ORDER BY created_at ASC
LIMIT :limit;

deleteOldestBeyondLimit:
DELETE FROM CachedMessage
WHERE chat_id = :chatId AND id NOT IN (
    SELECT id FROM CachedMessage
    WHERE chat_id = :chatId
    ORDER BY created_at DESC
    LIMIT :limit
);

deleteById:
DELETE FROM CachedMessage WHERE id = :id;

updateContent:
UPDATE CachedMessage SET content = :content, is_edited = 1, content_status = 'EDITED', edited_at = :editedAt WHERE id = :id;

markDeleted:
UPDATE CachedMessage SET is_deleted = 1, content_status = 'DELETED', content = '', media_url = NULL, metadata = NULL, deleted_at = :deletedAt WHERE id = :id;

updateReadBy:
UPDATE CachedMessage SET read_by = :read_by, delivery_status = 'READ', read_at = :readAt WHERE id = :id;

updateDeliveryStatus:
UPDATE CachedMessage SET delivery_status = :deliveryStatus, delivered_at = :deliveredAt WHERE id = :id;

deleteAll:
DELETE FROM CachedMessage;
-- Soft delete queries - exclude locally deleted items
selectActiveByChatId:
SELECT * FROM CachedMessage
WHERE chat_id = :chatId AND is_locally_deleted = 0
ORDER BY created_at ASC
LIMIT :limit;

selectActiveById:
SELECT * FROM CachedMessage
WHERE id = :id AND is_locally_deleted = 0;

-- Cursor-based pagination (keyset) for older messages (before cursor)
selectActiveByChatIdBefore:
SELECT * FROM CachedMessage
WHERE chat_id = :chatId AND is_locally_deleted = 0
  AND (
    created_at < :beforeCreatedAt
    OR (created_at = :beforeCreatedAt AND id < :beforeId)
  )
ORDER BY created_at DESC, id DESC
LIMIT :limit;

-- Cursor-based pagination (keyset) for newer messages (after cursor)
selectActiveByChatIdAfter:
SELECT * FROM CachedMessage
WHERE chat_id = :chatId AND is_locally_deleted = 0
  AND (
    created_at > :afterCreatedAt
    OR (created_at = :afterCreatedAt AND id > :afterId)
  )
ORDER BY created_at ASC, id ASC
LIMIT :limit;

-- Mark as locally deleted (soft delete to prevent reappearance from stale cache)
markLocallyDeleted:
UPDATE CachedMessage SET is_locally_deleted = 1, updated_at = :updatedAt WHERE id = :id;

markMultipleLocallyDeleted:
UPDATE CachedMessage SET is_locally_deleted = 1, updated_at = :updatedAt WHERE id IN :ids;

-- Sync queries
selectForSync:
SELECT * FROM CachedMessage
WHERE updated_at > :sinceTimestamp AND chat_id = :chatId
ORDER BY created_at ASC;

-- Clear all messages for account switch
deleteAllByChatId:
DELETE FROM CachedMessage WHERE chat_id = :chatId;

-- Get pending local changes for push sync
selectPendingMessages:
SELECT * FROM CachedMessage
WHERE updated_at > last_synced_at
AND delivery_status = 'SENDING';

-- Delete expired messages for a chat
deleteExpired:
DELETE FROM CachedMessage
WHERE chat_id = :chatId
  AND expires_at IS NOT NULL
  AND expires_at < :now
  AND is_locally_deleted = 0;